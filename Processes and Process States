#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main(void)
{
    for (int i = 0; i < 2; i++)
    {
        pid_t pid = fork();

        if (pid < 0)
        {
            perror("fork");
            return 1;
        }

        if (pid == 0)
        {
            printf("Child %d: PID=%d PPID=%d\n",
                   i + 1, getpid(), getppid());
            fflush(stdout);
            sleep(5);
            _exit(0);
        }
    }

    printf("Parent: PID=%d\n", getpid());

    wait(NULL);
    wait(NULL);

    return 0;
}
